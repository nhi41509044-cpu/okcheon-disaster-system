{
  "rules": {
    "okc_allow": {
      ".read": "auth != null && root.child('okc_allow').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('okc_allow').child(auth.uid).child('role').val() === 'admin' || (!root.child('okc_allow').exists() && auth.uid === $uid))"
      }
    },
    "okc_pending": {
      ".read": "auth != null && root.child('okc_allow').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('okc_allow').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "okc_secmeta_v6": {
      ".read": true,
      ".write": "auth != null && root.child('okc_allow').child(auth.uid).child('role').val() === 'admin'"
    },
    "okc_cryptmeta_v6": {
      ".read": "auth != null && root.child('okc_allow').child(auth.uid).exists()",
      ".write": "auth != null && root.child('okc_allow').child(auth.uid).child('role').val() === 'admin'"
    },
    "$other": {
      ".read": "$other !== 'okc_allow' && $other !== 'okc_pending' && $other !== 'okc_secmeta_v6' && $other !== 'okc_cryptmeta_v6' && auth != null && root.child('okc_allow').child(auth.uid).exists()",
      ".write": "$other !== 'okc_allow' && $other !== 'okc_pending' && $other !== 'okc_secmeta_v6' && $other !== 'okc_cryptmeta_v6' && auth != null && root.child('okc_allow').child(auth.uid).exists()"
    }
  }
}
